---
import { Image } from 'astro:assets';

import ArrowLink from '../components/ArrowLink.astro';
import ServiceRail from '../components/ServiceRail.astro';
import { MEDIA } from '../content/media';
import { SITE } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pierce O’Brien Piano | Piano Tuning & Thoughtful Piano Care"
  description={SITE.defaultDescription}
  includeOrganization
>
  <section class="hero">
    <div class="hero-grid shell">
      <div class="hero-copy">
        <h1>{SITE.coreMessage}</h1>
        <p>Performance-level tuning, repair, and refinement.</p>
        <div class="hero-actions">
          <a class="button button--primary" href={SITE.booking.href}>Book Now</a>
          <a class="button button--outline" href="#services">Explore Services</a>
        </div>
      </div>

      <div class="hero-media">
        <Image
          src={MEDIA.portrait}
          alt="Pierce O’Brien seated behind the strings of a grand piano"
          widths={[720, 960, 1280, 1800]}
          quality={60}
          sizes="(max-width: 960px) 100vw, 45vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="section" id="services">
    <div class="shell">
      <div class="section-heading">
        <h2>Care for pitch, touch, tone, and condition.</h2>
        <p>
          Choose the kind of care that sounds closest to what your piano needs. Every appointment
          begins with a careful assessment and clear next steps.
        </p>
      </div>
      <ServiceRail />
    </div>
  </section>

  <section class="section section--dark">
    <div class="editorial-split shell">
      <div class="editorial-copy">
        <h2>The whole instrument matters.</h2>
        <p>
          A piano is more than its last tuning. Pierce listens for pitch, touch, tone, condition,
          and the details that shape how the instrument feels to play.
        </p>
        <ArrowLink href="/about-pierce/" label="Meet Pierce" />
      </div>
      <div class="media-frame media-frame--landscape">
        <Image
          src={MEDIA.workingMonochrome}
          alt="Pierce O’Brien working at a grand piano"
          widths={[640, 960, 1440]}
          sizes="(max-width: 960px) 100vw, 52vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="closing-action shell">
      <h2>Bring your piano closer to its best.</h2>
      <ArrowLink href={SITE.booking.href} label="Book Now" />
    </div>
  </section>
</BaseLayout>
