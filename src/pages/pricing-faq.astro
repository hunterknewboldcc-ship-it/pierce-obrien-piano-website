---
import FaqList from '../components/FaqList.astro';
import PageIntro from '../components/PageIntro.astro';
import { MEDIA } from '../content/media';
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    question: 'What is the difference between tuning, regulation, and voicing?',
    answer:
      'Tuning addresses pitch. Regulation addresses touch and mechanical response in the action. Voicing addresses tonal character. A piano may need one or more of these services, and an assessment helps separate the concerns.',
  },
  {
    question: 'What is a pitch raise?',
    answer:
      'A pitch raise is a preliminary correction for a piano that is significantly flat. It brings overall string tension closer to the intended level before a fine tuning. The need for one is determined after assessing the piano.',
  },
  {
    question: 'Do you tune pianos after a move?',
    answer:
      'Yes. Pierce offers tuning after moving. The right timing and whether the piano also needs a pitch raise depend on the instrument, its condition, the move, and its new environment.',
  },
  {
    question: 'Which piano types are listed for service?',
    answer:
      'The owner questionnaire lists acoustic uprights, grand pianos, player pianos, and historic or antique instruments. Confirm the exact service scope in advance for player, historic, or antique pianos.',
  },
  {
    question: 'What is the same-day cancellation or rescheduling policy?',
    answer: 'Same-day cancellations carry a $100 fee. Same-day rescheduling carries a $50 fee.',
  },
  {
    question: 'How do travel charges work?',
    answer:
      'Travel fees are quoted for the appointment location. If you would like an estimate, request it before booking; the appropriate travel fee is confirmed by phone or text before booking.',
  },
  {
    question: 'What happens at the first appointment?',
    answer:
      'Pierce begins with an assessment and consultation, looking at the piano as a whole rather than tuning in isolation. The first appointment also includes light dusting and key cleaning, followed by practical recommendations for the piano’s next steps.',
  },
  {
    question: 'How does Pierce approach tuning?',
    answer:
      'Pierce tunes by ear and listens beyond pitch alone. Each piano is approached as an individual instrument, with attention to touch, tone, condition, and the musical character the owner wants to bring forward.',
  },
  {
    question: 'How do I book?',
    answer: 'Book Now links directly to Pierce’s Gazelle scheduling page.',
  },
];
---

<BaseLayout
  title="Piano Care FAQ | Pierce O’Brien Piano"
  description="Review practical answers about piano tuning, regulation, voicing, moving, travel, and booking with Pierce O’Brien Piano."
>
  <PageIntro
    title="Piano Care FAQ"
    introduction="Find practical answers about piano care before booking. Service pricing is discussed within the relevant service page and confirmed from the piano’s assessed needs."
    image={MEDIA.tuning}
    imageAlt="Pierce O’Brien tuning a grand piano in a room lined with books"
    actionLabel="Explore Services"
    actionHref="https://gazelleapp.io/scheduling/96knDrjXX3V40FVCG3cmzBgq"
  />

  <section class="section section--paper" id="faq">
    <div class="shell">
      <div class="section-heading">
        <h2>Frequently asked questions.</h2>
        <p>
          These answers provide useful general context; the specific piano still guides the service
          conversation.
        </p>
      </div>
      <FaqList items={faqs} />
    </div>
  </section>
</BaseLayout>
