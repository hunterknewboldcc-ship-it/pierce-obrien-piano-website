---
import ArrowLink from '../components/ArrowLink.astro';
import PageIntro from '../components/PageIntro.astro';
import PendingCopy from '../components/PendingCopy.astro';
import { MEDIA } from '../content/media';
import BaseLayout from '../layouts/BaseLayout.astro';

const intakeItems = [
  'Requested service',
  'Piano type',
  'General city or neighborhood',
  'Approximate last-tuned date',
  'Whether the piano was moved',
  'Symptoms or concerns',
  'Photos, when supported',
  'Preferred contact method',
  'Preferred appointment window',
];
---

<BaseLayout
  title="Book Piano Service | Pierce O’Brien Piano"
  description="Prepare the useful details for a piano-service request while the approved Gazelle booking and contact destinations are connected."
>
  <PageIntro
    title="Book / Contact"
    introduction="The booking experience is designed to be direct and mobile-friendly. The approved Gazelle destination, contact details, and quote-routing workflow still need final owner confirmation."
    image={MEDIA.hero}
    imageAlt="Pierce O’Brien working at a grand piano"
    actionLabel="View Booking Status"
    actionHref="#booking-status"
  />

  <section class="section section--paper" id="booking-status">
    <div class="shell">
      <div class="section-heading">
        <h2>One clear path to the calendar.</h2>
        <p>
          Once confirmed, Book Now will connect directly to Gazelle and be tested from both desktop
          and mobile before launch.
        </p>
      </div>
      <PendingCopy>
        Connect the approved Gazelle URL, verify its mobile behavior, define a fallback path, and
        add the approved text and quote destinations. No information is collected by this preview.
      </PendingCopy>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <h2>Details that make the first reply useful.</h2>
        <p>
          The future quote or booking intake should ask only for information that helps prepare for
          the piano and requested service.
        </p>
      </div>
      <ol class="intake-list">
        {
          intakeItems.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {item}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--dark">
    <div class="closing-action shell">
      <h2>Final destination pending owner approval.</h2>
      <ArrowLink href="/pricing-faq/" label="Review Common Questions" />
    </div>
  </section>
</BaseLayout>
