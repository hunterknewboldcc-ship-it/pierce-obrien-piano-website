---
import ArrowLink from '../components/ArrowLink.astro';
import PageIntro from '../components/PageIntro.astro';
import { MEDIA } from '../content/media';
import { SITE } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const intakeItems = [
  'Requested service',
  'Piano type',
  'General city or neighborhood',
  'Approximate last-tuned date',
  'Whether the piano was moved',
  'Symptoms or concerns',
  'Photos, when supported',
  'Preferred contact method',
  'Preferred appointment window',
];
---

<BaseLayout
  title="Book Piano Service | Pierce O’Brien Piano"
  description="Book piano service through Pierce O’Brien Piano’s Gazelle scheduling page and prepare useful details for a request."
>
  <PageIntro
    title="Book / Contact"
    introduction="Book Now opens Pierce’s Gazelle scheduling page. Share the details of the piano and the service you need so the appointment can begin with useful context."
    image={MEDIA.hero}
    imageAlt="Pierce O’Brien working at a grand piano"
    actionLabel="Book Now"
    actionHref={SITE.booking.href}
  />

  <section class="section section--paper" id="booking-status">
    <div class="shell">
      <div class="section-heading">
        <h2>One clear path to the calendar.</h2>
        <p>Book Now opens Pierce’s Gazelle scheduling page.</p>
      </div>
      <p class="reading-width">
        The online schedule is the current way to begin a piano-service request. For travel-fee
        questions, ask before booking so Pierce can quote the appropriate amount.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <h2>Details that make the first reply useful.</h2>
        <p>
          The future quote or booking intake should ask only for information that helps prepare for
          the piano and requested service.
        </p>
      </div>
      <ol class="intake-list">
        {
          intakeItems.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {item}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--dark">
    <div class="closing-action shell">
      <h2>Ready when your piano is.</h2>
      <ArrowLink href={SITE.booking.href} label="Book Now" />
    </div>
  </section>
</BaseLayout>
