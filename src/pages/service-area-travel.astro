---
import ArrowLink from '../components/ArrowLink.astro';
import PageIntro from '../components/PageIntro.astro';
import { MEDIA } from '../content/media';
import { SITE } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Piano Service Area & Travel | Pierce O’Brien Piano"
  description="Learn where Pierce O’Brien Piano provides service and how travel charges are calculated for Salt Lake City appointments."
>
  <PageIntro
    title="Service Area & Travel"
    introduction="Pierce is based in Sandy / Cottonwood Heights and currently serves Salt Lake City. Travel is included within 20 miles of the service base."
    image={MEDIA.hero}
    imageAlt="Pierce O’Brien working at the strings of a grand piano"
    actionLabel="Book Now"
    actionHref="https://gazelleapp.io/scheduling/96knDrjXX3V40FVCG3cmzBgq"
  />

  <section class="section section--paper">
    <div class="service-content shell">
      <div class="service-index">
        <p>Coverage principle</p>
        <ol>
          <li>Use the appointment location</li>
          <li>Keep a private address private</li>
          <li>Confirm travel before booking</li>
        </ol>
      </div>
      <div class="service-sections">
        <section class="content-section">
          <h2>Public service territory</h2>
          <p>
            Pierce is based in Sandy / Cottonwood Heights and serves Salt Lake City. This is a
            service business, so the residential service origin remains private.
          </p>
        </section>

        <section class="content-section">
          <h2>Travel policy</h2>
          <p>
            Travel is included within 20 miles of Pierce’s service base. Beyond that included area,
            travel is billed at $0.65 per mile round trip. If you are concerned about travel, ask
            about the fee before booking and Pierce will quote the appropriate amount.
          </p>
        </section>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="closing-action shell">
      <h2>Confirm coverage before the visit.</h2>
      <ArrowLink href={SITE.booking.href} label="Book Now" />
    </div>
  </section>
</BaseLayout>
