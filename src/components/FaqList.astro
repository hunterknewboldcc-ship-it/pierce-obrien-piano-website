---
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  items: Faq[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <div class="faq-answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))
  }
</div>
