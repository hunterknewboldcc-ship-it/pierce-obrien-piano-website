---
import { SERVICE_CATEGORIES } from '../content/site';
---

<nav class="services-preview" aria-label="Services">
  {
    SERVICE_CATEGORIES.map((service) => (
      <a href={service.href}>
        <span>{service.title}</span>
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path
            d="M3 10h13m-5-5 5 5-5 5"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.4"
          />
        </svg>
      </a>
    ))
  }
</nav>
