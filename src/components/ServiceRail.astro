---
import { SERVICE_CATEGORIES } from '../content/site';

interface Props {
  showPricing?: boolean;
}

const { showPricing = false } = Astro.props;
---

<div class="service-rail">
  {
    SERVICE_CATEGORIES.map((service) => (
      <a class="service-row" href={service.href}>
        <h3>{service.title}</h3>
        <div class="service-row-copy">
          <p>{service.summary}</p>
          {showPricing && <span class="service-price">{service.price}</span>}
        </div>
        <svg class="service-arrow" viewBox="0 0 20 20" aria-hidden="true">
          <path
            d="M3 10h13m-5-5 5 5-5 5"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.4"
          />
        </svg>
      </a>
    ))
  }
</div>
